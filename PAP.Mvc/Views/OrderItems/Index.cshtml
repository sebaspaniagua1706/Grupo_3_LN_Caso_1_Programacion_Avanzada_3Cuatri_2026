@model IEnumerable<PAP.DataAccess.OrderItem>

@{
    ViewBag.Title = "Order items";
    var items = Model != null ? Model.ToList() : new List<PAP.DataAccess.OrderItem>();
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-2">Order items</h1>
            <p class="text-muted mb-0">
                @if (items.Count >= 100)
                {
                    <text>Showing the first 100 records</text>
                }
                else
                {
                    <text>@items.Count record@(items.Count == 1 ? "" : "s")</text>
                }
            </p>
        </div>
    </div>

    @if (!items.Any())
    {
        <div class="alert alert-info" role="alert">
            There is no data to show yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Order #</th>
                        <th scope="col">Book</th>
                        <th scope="col">Qty</th>
                        <th scope="col">Unit price</th>
                        <th scope="col">Discount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in items)
                    {
                        <tr>
                            <td>@x.Id</td>
                            <td>@x.OrderId</td>
                            <td>@(x.Book.Title)</td>
                            <td>@x.Quantity</td>
                            <td>@x.UnitPrice.ToString("C")</td>
                            <td>@x.Discount.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
