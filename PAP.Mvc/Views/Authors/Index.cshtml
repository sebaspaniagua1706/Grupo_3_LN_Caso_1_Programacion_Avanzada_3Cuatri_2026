@model IEnumerable<PAP.DataAccess.Author>

@{
    ViewBag.Title = "Authors";
    var items = Model != null ? Model.ToList() : new List<PAP.DataAccess.Author>();
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-2">Authors</h1>
            <p class="text-muted mb-0">
                @if (items.Count >= 100)
                {
                    <text>Showing the first 100 records</text>
                }
                else
                {
                    <text>@items.Count record@(items.Count == 1 ? "" : "s")</text>
                }
            </p>
        </div>
    </div>

    @if (!items.Any())
    {
        <div class="alert alert-info" role="alert">
            There is no data to show yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">First name</th>
                        <th scope="col">Last name</th>
                        <th scope="col">Country</th>
                        <th scope="col">Birth date</th>
                        <th scope="col">Created</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in items)
                    {
                        <tr>
                            <td>@x.Id</td>
                            <td>@x.FirstName</td>
                            <td>@x.LastName</td>
                            <td>@x.Country</td>
                            <td>@(x.BirthDate.HasValue ? x.BirthDate.Value.ToString("yyyy-MM-dd") : "")</td>
                            <td>@x.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
