@model IEnumerable<PAP.Models.BookAuthorRow>

@{
    ViewBag.Title = "Book authors";
    var items = Model != null ? Model.ToList() : new List<PAP.Models.BookAuthorRow>();
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-2">Book authors</h1>
            <p class="text-muted mb-0">
                @if (items.Count >= 100)
                {
                    <text>Showing the first 100 records</text>
                }
                else
                {
                    <text>@items.Count record@(items.Count == 1 ? "" : "s")</text>
                }
            </p>
        </div>
    </div>

    @if (!items.Any())
    {
        <div class="alert alert-info" role="alert">
            There is no data to show yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Book #</th>
                        <th scope="col">Book</th>
                        <th scope="col">Author #</th>
                        <th scope="col">Author</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in items)
                    {
                        <tr>
                            <td>@x.BookId</td>
                            <td>@x.BookTitle</td>
                            <td>@x.AuthorId</td>
                            <td>@x.AuthorName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
