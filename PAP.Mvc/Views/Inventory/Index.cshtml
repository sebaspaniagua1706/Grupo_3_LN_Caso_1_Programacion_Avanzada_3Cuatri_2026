@model IEnumerable<PAP.DataAccess.Inventory>

@{
    ViewBag.Title = "Inventory";
    var items = Model != null ? Model.ToList() : new List<PAP.DataAccess.Inventory>();
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-2">Inventory</h1>
            <p class="text-muted mb-0">
                @if (items.Count >= 100)
                {
                    <text>Showing the first 100 records</text>
                }
                else
                {
                    <text>@items.Count record@(items.Count == 1 ? "" : "s")</text>
                }
            </p>
        </div>
    </div>

    @if (!items.Any())
    {
        <div class="alert alert-info" role="alert">
            There is no data to show yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Book</th>
                        <th scope="col">In stock</th>
                        <th scope="col">Reorder level</th>
                        <th scope="col">Last restocked</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in items)
                    {
                        <tr>
                            <td>@x.Id</td>
                            <td>@(x.Book.Title)</td>
                            <td>@x.QuantityInStock</td>
                            <td>@x.ReorderLevel</td>
                            <td>@(x.LastRestockedAt.HasValue ? x.LastRestockedAt.Value.ToString("yyyy-MM-dd HH:mm") : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
