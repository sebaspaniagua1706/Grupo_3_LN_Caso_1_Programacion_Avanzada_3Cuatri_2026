@model IEnumerable<PAP.DataAccess.Payment>

@{
    ViewBag.Title = "Payments";
    var items = Model != null ? Model.ToList() : new List<PAP.DataAccess.Payment>();
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-2">Payments</h1>
            <p class="text-muted mb-0">
                @if (items.Count >= 100)
                {
                    <text>Showing the first 100 records</text>
                }
                else
                {
                    <text>@items.Count record@(items.Count == 1 ? "" : "s")</text>
                }
            </p>
        </div>
    </div>

    @if (!items.Any())
    {
        <div class="alert alert-info" role="alert">
            There is no data to show yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Order #</th>
                        <th scope="col">Method</th>
                        <th scope="col">Amount</th>
                        <th scope="col">Date</th>
                        <th scope="col">Status</th>
                        <th scope="col">Reference</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in items)
                    {
                        <tr>
                            <td>@x.Id</td>
                            <td>@x.OrderId</td>
                            <td>@x.PaymentMethod</td>
                            <td>@x.Amount.ToString("C")</td>
                            <td>@x.PaymentDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@x.Status</td>
                            <td>@x.TransactionRef</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
