@model IEnumerable<PAP.DataAccess.PurchaseOrder>

@{
    ViewBag.Title = "Purchase orders";
    var items = Model != null ? Model.ToList() : new List<PAP.DataAccess.PurchaseOrder>();
}

<main>
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-2">Purchase orders</h1>
            <p class="text-muted mb-0">
                @if (items.Count >= 100)
                {
                    <text>Showing the first 100 records</text>
                }
                else
                {
                    <text>@items.Count record@(items.Count == 1 ? "" : "s")</text>
                }
            </p>
        </div>
    </div>

    @if (!items.Any())
    {
        <div class="alert alert-info" role="alert">
            There is no data to show yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Id</th>
                        <th scope="col">Supplier</th>
                        <th scope="col">Order date</th>
                        <th scope="col">Expected</th>
                        <th scope="col">Status</th>
                        <th scope="col">Total cost</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in items)
                    {
                        <tr>
                            <td>@x.Id</td>
                            <td>@(x.Supplier.Name)</td>
                            <td>@x.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(x.ExpectedDate.HasValue ? x.ExpectedDate.Value.ToString("yyyy-MM-dd") : "")</td>
                            <td>@x.Status</td>
                            <td>@x.TotalCost.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</main>
