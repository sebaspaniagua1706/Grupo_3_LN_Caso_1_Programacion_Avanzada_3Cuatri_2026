@model IEnumerable<PAP.Generators.IGenerator>

@{
    ViewBag.Title = "Administración";
}

<h2>Generación de datos</h2>

<p>
    Desde esta pantalla puede generar los datos iniciales
    de cada tabla.
</p>

<div class="alert alert-info">
    Los datos deben generarse respetando el orden mostrado.
    Si una tabla ya contiene registros, el sistema impedirá
    generar datos duplicados.
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <strong>Proceso completado:</strong>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <strong>No se pudo generar:</strong>
        @TempData["Error"]
    </div>
}

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Orden</th>
            <th>Entidad</th>
            <th>Registros actuales</th>
            <th>Estado</th>
            <th>Acción</th>
        </tr>
    </thead>

    <tbody>
        @{
            var position = 1;
        }

        @foreach (var generator in Model)
        {
            var currentRecords = generator.Count();
            var hasData = currentRecords > 0;

            var buttonClass = hasData
                ? "btn btn-warning"
                : "btn btn-primary";

            var buttonText = hasData
                ? "Verificar generación"
                : "Generar datos";

            <tr>
                <td>
                    @position
                </td>

                <td>
                    @generator.EntityName
                </td>

                <td>
                    @currentRecords
                </td>

                <td>
                    @if (hasData)
                    {
                        <span class="badge bg-success">
                            Con datos
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Sin datos
                        </span>
                    }
                </td>

                <td>
                    @using (Html.BeginForm(
                        "Generate",
                        "Admin",
                        FormMethod.Post,
                        new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.Hidden(
                                 "entity",
                                 generator.EntityName)

                        <button type="submit"
                                class="@buttonClass">
                            @buttonText
                        </button>
                    }
                </td>
            </tr>

            position++;
        }
    </tbody>
</table>