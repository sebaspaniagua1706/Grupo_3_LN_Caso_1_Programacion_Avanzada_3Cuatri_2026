@model IEnumerable<PAP.Generators.GeneratorStatus>

@{
    ViewBag.Title = "Administración";
}

<h2>Generación de datos</h2>

<p>
    Los botones se habilitan automáticamente cuando las
    dependencias necesarias contienen datos.
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <strong>Proceso completado:</strong>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <strong>No se pudo generar:</strong>
        @TempData["Error"]
    </div>
}

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Orden</th>
            <th>Entidad</th>
            <th>Dependencias</th>
            <th>Registros</th>
            <th>Estado</th>
            <th>Acción</th>
        </tr>
    </thead>

    <tbody>
        @{
            var position = 1;
        }

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @position
                </td>

                <td>
                    @item.EntityName
                </td>

                <td>
                    @item.DependenciesText
                </td>

                <td>
                    @item.CurrentRecords
                </td>

                <td>
                    <span class="@item.StatusClass">
                        @item.StatusText
                    </span>
                </td>

                <td>
                    @using (Html.BeginForm(
                        "Generate",
                        "Admin",
                        FormMethod.Post,
                        new { @class = "d-inline" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.Hidden(
                                 "entity",
                                 item.EntityName)

                        if (item.CanGenerate)
                        {
                            <button type="submit"
                                    class="btn btn-primary">
                                @item.ButtonText
                            </button>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn btn-secondary"
                                    disabled="disabled"
                                    title="@item.ValidationMessage">
                                @item.ButtonText
                            </button>
                        }
                    }
                </td>
            </tr>

            position++;
        }
    </tbody>
</table>